# TradeIQX Backend Environment Configuration Template
# Copy this file to .env and configure local values.
# NEVER commit the actual .env file or real secrets to version control.

# Database Configuration
# Default is local SQLite. For PostgreSQL: postgresql://user:password@localhost:5432/tradeiqx
DATABASE_URL=sqlite:///./tradeiqx.db

# Authentication and Security
# Generate a secure secret using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_secure_hex_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Configuration
BACKEND_HOST=0.0.0.0
PORT=8001
BACKEND_PORT=8001

# Groww Market Data API Credentials (placeholders only, no real values)
GROWW_API_KEY=your_groww_api_key_here
GROWW_API_SECRET=your_groww_api_secret_here

# AI Mentor / RAG Configuration
LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_MODEL=gemini-2.5-flash
RAG_TOP_K=3
RAG_THRESHOLD=0.3
